# Copy this file to `.env` and fill in the values. `.env` is ignored by git.
# Where to find them: Supabase dashboard > your project > Connect (or Settings > API Keys).
# Only the public (publishable) key goes here. NEVER use the secret / service_role key in the app.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_...). The legacy "anon" JWT key also works here.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
